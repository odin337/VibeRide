{
  "name": "@viberide/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts: domain types, typed EventBus, zod API schemas, deterministic PRNG/hash utilities, feature flags, structured logger",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.4",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
