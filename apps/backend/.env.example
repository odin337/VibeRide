# =============================================================================
# VibeRide backend — runtime configuration (apps/backend/.env).
# Copy to .env next to this file for local development; docker-compose reads it
# via env_file. NEVER commit the real .env. Variable names and defaults match
# docs/SETUP.md; validation lives in src/config/env.ts (zod).
# =============================================================================

# development | test | production
NODE_ENV=development

# HTTP listen port / interface.
PORT=3000
HOST=0.0.0.0

# Minimum log level: debug | info | warn | error. Pretty-printed output is
# enabled automatically in development (pino-pretty), JSON lines otherwise.
LOG_LEVEL=info

# HMAC secret for session JWTs. REQUIRED in production — the app refuses to
# boot without it. In development/test a fixed built-in fallback is used and a
# warning is logged.
# TODO(manual): generate a strong random value: openssl rand -hex 32
JWT_SECRET=

# Session token lifetime in seconds.
JWT_EXPIRES_IN=3600

# Bot token from @BotFather — used ONLY server-side to validate Telegram Mini
# App initData signatures. When unset, POST /api/auth/telegram responds 503.
# TODO(manual): create the bot and paste its token (see docs/SETUP.md).
TELEGRAM_BOT_TOKEN=

# Comma-separated origins allowed by CORS (the two Vite dev servers by default).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_SEC seconds per
# client. Auth and score routes have stricter built-in overrides (10 / 60 s).
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=60

# Server-side feature flags (parsed by resolveFeatureFlags from
# @viberide/shared; accepted spellings: 1/true/yes/on and 0/false/no/off).
FEATURE_TON=false
FEATURE_NFT_SKINS=false
FEATURE_LEADERBOARD=true
FEATURE_TELEGRAM=false
