{
  "name": "@viberide/backend",
  "version": "0.1.0",
  "private": true,
  "description": "VibeRide REST API: Telegram/guest auth, track registry, anti-cheat validated score submission, per-track leaderboards, Prometheus metrics and health probes",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@viberide/shared": "workspace:*",
    "@viberide/track-generator": "workspace:*",
    "fastify": "5.8.5",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/node": "^24.0.3",
    "@vitest/coverage-v8": "^3.1.4",
    "pino-pretty": "^13.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
