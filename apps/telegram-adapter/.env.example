# Copy to .env.local and adjust. All VITE_* values are inlined at build time.

# Base URL of the VibeRide backend API (leave empty for same-origin requests).
VITE_API_BASE_URL=http://localhost:3000

# Feature flags (parsed by resolveFeatureFlags from @viberide/shared).
VITE_FEATURE_TON=false
VITE_FEATURE_NFT_SKINS=false
VITE_FEATURE_LEADERBOARD=true
VITE_FEATURE_TELEGRAM=true

# TODO(manual): set to the public HTTPS URL of your hosted tonconnect-manifest.json
# once the staging domain exists (required only when VITE_FEATURE_TON=true).
VITE_TONCONNECT_MANIFEST_URL=
