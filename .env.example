# =============================================================================
# VibeRide — compose-level variables.
# Copy to .env next to docker-compose.yml and adjust. NEVER commit the real .env.
# These are read by `docker compose` variable interpolation; per-app runtime
# config for local development lives in apps/*/.env.example.
# =============================================================================

# --- images (staging/production overlay: docker-compose.staging.yml) --------
# Image tag to run — CI publishes git SHAs and `latest` to GHCR. The deploy
# workflow rewrites TAG and maintains PREVIOUS_TAG for automatic rollback.
TAG=latest
# TODO(manual): lowercase <github_owner>/<repo> once the GitHub repo exists,
# e.g. IMAGE_PREFIX=acme/viberide
IMAGE_PREFIX=

# --- frontend build args (inlined into the Vite bundles at image build) -----
# Public origin of the backend API (empty = same-origin requests).
VITE_API_BASE_URL=http://localhost:3000

# Feature flags (parsed by resolveFeatureFlags from @viberide/shared).
VITE_FEATURE_TON=false
VITE_FEATURE_NFT_SKINS=false
VITE_FEATURE_LEADERBOARD=true

# TODO(manual): public HTTPS URL of the hosted tonconnect-manifest.json
# (required only when VITE_FEATURE_TON=true).
VITE_TONCONNECT_MANIFEST_URL=

# Extra origins appended to the nginx CSP connect-src of both frontends.
# With TON enabled append e.g.:
#   https://tonapi.io https://bridge.tonapi.io wss://bridge.tonapi.io
CSP_CONNECT_SRC=http://localhost:3000

# --- backend secrets (staging/production only) -------------------------------
# For local dev put these in apps/backend/.env instead (compose env_file).
# TODO(manual): >= 256-bit random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# TODO(manual): bot token from @BotFather (see apps/telegram-adapter/README.md).
TELEGRAM_BOT_TOKEN=
